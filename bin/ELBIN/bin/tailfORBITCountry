#!/bin/bash
# tailfORBIT [LOVE_directory_suffix]   [DOM_prefix]
# - check for Orbit signature in log files

LOVENUM=$1;
DOM=$2;

# See if LOVENUM is a number - switch parameters for ease of use
if [ -n "$LOVENUM" ] && [ -z "${LOVENUM//[0-9]}" ]; then
  echo "Checking in /LOVE$LOVENUM";
  # $LOVENUM is a number
else
  # LOVENUM is not a number
  # Assume we are searching for DOM
  if [ "$DOM" == "" ]; then
    DOM=$LOVENUM;
    # Search ALL LOVE roots
    LOVENUM="*";
  fi
fi

tail -f /LOVE$LOVENUM/*/$DOM*/_LOGS/access.log /LOVE$LOVENUM/$DOM*/_LOGS/*.log
  |grep -e'/o/' -e'/_STYLES/' -e'/favicon' -e'==' -e"^$" |/ELBIN/geologpipe.pl;


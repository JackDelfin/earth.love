<!--- EL_HEADER_OBJECT - Show the header for the Object in the Root - used on EL_SHOW_ --->
#OML[EL_FN_SET_WORD]#<!--- Set _word_short_ _word_name_ _word_color_ --->
#BOX_ROW_COLOR=NVL[#_word_color_#][#_root_color_#][#BOX_ROW_COLOR#]#
<div class="#BOX_ROW#"><h2>#NVL[#_WORD_NAME_#][#_WORD_SHORT_#]#</h2></div>
#RESTORE[BOX_ROW_COLOR]#
<!--- EL_SEARCH_CATS Search and Show Categories this item is on --->
#word=[cat]#
#_DATA_MSG_=MSG[Categories]#
#OML[EL_TOKENS_SEARCH]#
#DOTDOT=DOTDOT[#root#][cat]#<!--- #TESTING --->
#LOADTOKEN[
BOX_COLOR   =[el-chakra3]
_DATA_HREF_ =[#ELSHOW##1.tr#&object=cat]

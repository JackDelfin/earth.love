#-------------------------------------------------------------------------------
# Numeric and Math Related Functions
#-------------------------------------------------------------------------------
# 'ROUND'        # [num][decimals: 0-4] - Rounds a number to decimals specified
ROUND[]#            {#ROUND[#num7#][0]#}   <-- [#num7#][0]
ROUND[]#            {#ROUND[#num7#][1]#}   <-- [#num7#][1]


#num9=[0.1234567]#
# 'TRUNC'        # [num][decimals: 0-4] - Truncates a number to decimals specified
TRUNC[]#            {#TRUNC[#num9#][0]#}   <-- [#num9#][0]
TRUNC[]#            {#TRUNC[#num9#][1]#}   <-- [#num9#][1]
TRUNC[]#            {#TRUNC[#num9#][2]#}   <-- [#num9#][2]
TRUNC[]#            {#TRUNC[#num9#][3]#}   <-- [#num9#][3]
TRUNC[]#            {#TRUNC[#num9#][4]#}   <-- [#num9#][4]
TRUNC[]#            {#TRUNC[#num9#][5]#}   <-- [#num9#][4]

# 'SIGN'         # [num]                - Returns -1/0/1/null if num is negative, zero, positive, or null if not a number
SIGN[]#             {#SIGN[-42]#}   <-- [-42]
SIGN[]#             {#SIGN[42]#}   <-- [42]
SIGN[]#             {#SIGN[0]#}   <-- [0]
SIGN[]#             {#SIGN[#nothing#]#}   <-- [#nothing#]
# 'ABS'          # [num]                - Returns absolute value of a number (positive)
ABS[]#              {#ABS[-#num1#]#}   <-- [-#num1#]
ABS[]#              {#ABS[#num1#]#}   <-- [#num1#]
# 'MOD'          # [num][divisor]       - Returns the modulus (remainder) after a division
MOD[]#              {#MOD[#num7#][#num1#]#}   <-- [#num7#][#num1#]
MOD[]#              {#MOD[15][#num1#]#}   <-- [15][#num1#]
MOD[]#              {#MOD[#num7#]#}   <-- [#num7#]

# 'ADD'          # [num][num]...[num]   - Adds all the numbers in the list
ADD[]#              {#ADD[#num1#][#num2#][#num3#]#}   <-- [#num1#][#num2#][#num3#]
ADD[]#              {#ADD[#num1#]#}   <-- [#num1#]
Error case:
ADD[]#              {#ADD[15][apple]#}   <-- [15][apple]
ADD[]#              {#ADD[apple][15][apple]#}   <-- [apple][15][apple]

# 'SUB'          # [num][num]...[num]   - Subtracts all the numbers in the list from the first num
SUB[]#              {#SUB[#num1#][#num2#][#num3#]#}   <-- [#num1#][#num2#][#num3#]
SUB[]#              {#SUB[#num1#]#}   <-- [#num1#]
# 'SUBTRACT'     # Same as SUB
SUBTRACT[]#         {#SUBTRACT[#num1#][#num2#][#num3#]#}   <-- [#num1#][#num2#][#num3#]
Error case:
SUB[]#              {#SUB[15][apple]#}   <-- [15][apple]
SUB[]#              {#SUB[apple][15][apple]#}   <-- [apple][15][apple]

# 'MULT'         # [num][num]...[num]   - Multiplies all the numbers in the list
MULT[]#             {#MULT[#num1#][#num2#][#num3#]#}   <-- [#num1#][#num2#][#num3#]
MULT[]#             {#MULT[#num1#]#}   <-- [#num1#]
# 'MULTIPLY'     # Same as MULT
MULTIPLY[]#         {#MULTIPLY[#num1#][#num2#][#num3#]#}   <-- [#num1#][#num2#][#num3#]
Error case:
MULT[]#             {#MULT[15][apple]#}   <-- [15][apple]
MULT[]#             {#MULT[apple][15][apple]#}   <-- [apple][15][apple]

# 'DIV'          # [num][num]...[num]   - Divides all the numbers in the list from the first num
DIV[]#              {#DIV[#num3#][#num2#][#num1#]#}   <-- [#num3#][#num2#][#num1#]
DIV[]#              {#DIV[#num3#][#num1#]#}   <-- [#num3#][#num1#]
DIV[]#              {#DIV[#num1#]#}   <-- [#num1#]
# 'DIVIDE'       # Same as DIV
DIVIDE[]#           {#DIVIDE[#num3#][#num2#][#num1#]#}   <-- [#num3#][#num2#][#num1#]
Error case:
DIVIDE[]#           {#DIVIDE[15][apple]#}   <-- [15][apple]
DIVIDE[]#           {#DIVIDE[apple][15][apple]#}   <-- [apple][15][apple]

# 'MIN'          # [a][b]...[n]         - Returns the minimum (String/Numeric) from the list
MIN[]#              {#MIN[#num3#][#num2#][#num1#]#}   <-- [#num3#][#num2#][#num1#]
MIN[]#              {#MIN[#num1#]#}   <-- [#num1#]

# 'MAX'          # [a][b]...[n]         - Returns the maximum (String/Numeric) from the list
MAX[]#              {#MAX[#num3#][#num2#][#num1#]#}   <-- [#num3#][#num2#][#num1#]
MAX[]#              {#MAX[#num1#]#}   <-- [#num1#]

# 'AVG'          # [a][b]...[n]         - Returns the average of all numbers in the list
AVG[]#              {#AVG[#num3#][#num2#][#num1#]#}   <-- [#num3#][#num2#][#num1#]
AVG[]#              {#AVG[#num1#]#}   <-- [#num1#]



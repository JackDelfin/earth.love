# 'WRAP'         # [text].[max_linelength].[wordbreak_chars].[linebreak_chars]      - Wrap the text based on max linelength, and optionally wordbreak or linebreak characters
# 'WRAPTOKEN'    # [tokenName].[max_linelength].[wordbreak_chars].[linebreak_chars] - Same as WRAP, but directed to the specified tokenName

#text=[this is a multi line text entry with #one.1# token this is a multi line text entry with #one.1# token this is a multi line text entry with #one.1# token this is a multi line text entry with #one.1# token this is a multi line text entry with #one.1# token this is a multi line text entry with #one.1# token]#-
Text:[#text.length#]


<!--- #OML[EL_NAV_GENERIC]#
  Set tokens prior to call:
    MENU _subroot1-8 _NAVMSG _NAVDISPLAY
--->
<!--- Get the Token configurations for Navigation - touchy~feely stuff --->
#INC[EL_TOKENS_NAV_OML]#
<!--- Redefine ROOT when referenced within - this just references above ROOT1-7 in sequence --->
#ROOT=[#_subroot#]#
<!--- Get the ROOT name for display - This also calls MSG for translation where/when available --->
#_NAV1=OML[EL_FN_ROOT_SHORT_PARAM][#_subroot1#]#
#_NAV2=OML[EL_FN_ROOT_SHORT_PARAM][#_subroot2#]#
#_NAV3=OML[EL_FN_ROOT_SHORT_PARAM][#_subroot3#]#
#_NAV4=OML[EL_FN_ROOT_SHORT_PARAM][#_subroot4#]#
#_NAV5=OML[EL_FN_ROOT_SHORT_PARAM][#_subroot5#]#
#_NAV6=OML[EL_FN_ROOT_SHORT_PARAM][#_subroot6#]#
#_NAV7=OML[EL_FN_ROOT_SHORT_PARAM][#_subroot7#]#
#pmenu=NVL[#pmenu#][#menu#]#
<!--- Define the click-link --->
#_NAVLINK=[<a class="w3-link-plain" href="#ELSHOW#&pm=#pmenu#&m=#_subroot#&o=#_subroot#">#_NAVTEXT.omlWWRAP#</a>]#
<!--- SHOW THE CODE --->
<div class="w3-container">
<h2 class="#CLASS_FLOWER_HEAD# #_NAVMSGCOLOR#">#MSG[#_NAVMSG#]#</h2>
<div class="w3-container">#include![#_NAVDISPLAY#]#</div>
</div>
#RESTORE[ROOT]#
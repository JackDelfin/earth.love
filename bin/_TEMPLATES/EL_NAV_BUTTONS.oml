<!--- #OML[EL_NAV_BUTTONS]# - Navigation Buttons Layout --->
#LOADTOKEN[
CLASS_NAV_BUT = [w3-badge w3-card-4 w3-hover w3-cursive w3-xlarge w3-blue w3-link-plain w3-center]
Help       = HELPOVER[Go Back]
proot      =NVL[#proot#][#root#]
NAV_BACK   = EXISTS[#pmenu#][<a #HELP# class="#CLASS_NAV_BUT# w3-orange" href="#ELSHOWNAV#root=#proot#&menu=#pmenu#"><B>&laquo;</B></a>][]
]#
#EXISTS[#pmenu#][
<div class="w3-container w3-row w3-responsive">
#NAV_BACK#
</div>
]#

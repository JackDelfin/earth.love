<!--- Get the Token configurations for Navigation - touchy~feely stuff --->
#INCif[#omlCIRCLENAV.NOTEXISTS#][EL_TOKENS_NAV_OML]#
#LOADMSG[
_NAV1 = Self
_NAV2 = Mission
_NAV3 = Plan
_NAV4 = Values
_NAV5 = Path
_NAV6 = Vision
_NAV7 = Nature
]#
#LOADTOKEN[
PMENU     =[FLOWER]
_subroot1 =[FOLMOH_Self]
_subroot2 =[FOLMOH_Mission]
_subroot3 =[FOLMOH_Plan]
_subroot4 =[FOLMOH_Values]
_subroot5 =[FOLMOH_Path]
_subroot6 =[FOLMOH_Vision]
_subroot7 =[FOLMOH_Love]
_NAVLINK  =[<a class="w3-link-plain" href="#ELSHOW#&pmenu=#pmenu#&menu=#_subroot#">#_NAVTEXT#</a>]
]#
<div class="w3-container">
<h2 class="#CLASS_FLOWER_HEAD# w3-indigo">#MSG[Flower of Life Navigator]#</h2>
<div class="w3-container">#include![EL_VIEW_FLOWER]#</div>
</div>
<br>
<!--- Full Flower Button: #OML[EL_BUTTON][object][menu][word][Button Name]#--->
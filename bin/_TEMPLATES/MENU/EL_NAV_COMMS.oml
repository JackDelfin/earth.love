<!--- Get the Token configurations for Navigation - touchy~feely stuff --->
#INCif[#omlCIRCLENAV.NOTEXISTS#][EL_TOKENS_NAV_OML]#
#LOADMSG[
FlowerHead =[Community Navigator]
_NAV1      =[Self]
_NAV2      =[Mission]
_NAV3      =[Plan]
_NAV4      =[Values]
_NAV5      =[Path]
_NAV6      =[Vision]
_NAV7      =[Nature]
]#
#LOADTOKEN[
PMENU     =[COMMS]
_subroot1 =[COMM_Self]
_subroot2 =[COMM_Mission]
_subroot3 =[COMM_Plan]
_subroot4 =[COMM_Values]
_subroot5 =[COMM_Path]
_subroot6 =[COMM_Vision]
_subroot7 =[COMM_Nature]
_NAVLINK  =[<a class="w3-link-plain" href="#ELSHOW#&pmenu=#pmenu#&menu=#_subroot#">#_NAVTEXT#</a>]
]#
<div class="w3-container">
<h2 class="#CLASS_FLOWER_HEAD# w3-green">#FlowerHead#</h2>
<div class="w3-container">#include![EL_VIEW_FLOWER]#</div>
</div>

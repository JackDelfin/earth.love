<html>
<meta charset="utf-8">
<head>
<!--- earth.love Orbit OML Template - This comment will not be shown in page --->
<!-- License: AGPLv3+: GNU Affero General Public License Version 3 or later -->
<!-- earth.love Planetary Directory - Every One owns the words -->
<title>#TITLE#</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
#INC![_STYLES/#STYLE#]#
</head>
<body class="#MOBILE#w3-container w3-responsive">
<header class="#HEADER_BOX#">
  <div class="w3-row w3-container w3-round-xlarge">
    <div class="w3-third"><h2>#HEADER#</h2></div>
    <div class="w3-third w3-center"><h3>#HEADER_CENTER#</h3>#OML[EL_NAV_BUTTONS]#</div>
    <div class="w3-third w3-right-align">
      #INCLUDE[EL_FORM_SEARCH_HEADER]#
      <div class="w3-bar w3-right-align">
        #EQUAL[#AUTHENTICATED#][1][
          <span class="w3-bar-item">#AUTH_USER.html#</span>
          <a class="w3-bar-item w3-button w3-round-large" href="#_ORBIT#elpasswd">#MSG[Change passphrase]#</a>
          <form name="logoff" action="#_ORBIT#ellogoff" method="post" class="w3-bar-item w3-margin-bottom-0">
            <input type="hidden" name="csrf_token" value="#CSRF_TOKEN.html#">
            <input type="hidden" name="return_to" value="#RETURN_TO.html#">
            <button type="submit" class="w3-button w3-round-large">#MSG[Log off]#</button>
          </form>
        ][
          <form name="logon_link" action="#_ORBIT#ellogon" method="get" class="w3-bar-item w3-margin-bottom-0">
            <input type="hidden" name="return_to" value="#RETURN_TO.html#">
            <button type="submit" class="w3-button w3-round-large">#MSG[Log on]#</button>
          </form>
        ]#
      </div>
      #EQUAL[#AUTH_CAN_WRITE#][1][#ifINC[#_WORDFOUND_.0#][EL_ADD_BUTTONS]#]#
    </div>
  </div>
</header>
#IFOML![#DEBUG.0#][EL_DEBUG_HEADER]#
#EXISTS[#MSG_URGENT#][<div class="w3-red w3-center #HEADER_MESSAGE_BOX#"><strong>#MSG_URGENT#</strong></div>]#
#EXISTS[#HEADER_MESSAGE#][<div class="#HEADER_MESSAGE_BOX#">#HEADER_MESSAGE#</div>]#

<!--- EL_TOKENS_SEARCH - OML Tokens for supporting Search --->
#LOADTOKEN[
_DATA_HEAD_=[<div class="#BOX#"><div class="#BOX_HEAD#"><h3>#_DATA_MSG_#</h3></div>]
_DATA_HREF_=[#SHOWPAGElite##1.tr#&p=el_show&o=word]
_DATA_BODY_=[<a class="w3-link-plain" href="#_DATA_HREF_#"><div id="list" class="#BOX_ROW#">#1.html#</div></a>]
_DATA_FOOT_=[#NEXT_PREV#</div>]
]#
#OMLIF[#_STATIC_#][EL_TOKENS_SEARCH_STATIC]#
<!--- Backup for convenience when overriding --->
#BACKUP[_DATA_HEAD_][_DATA_HREF_][_DATA_BODY_][_DATA_FOOT_]#
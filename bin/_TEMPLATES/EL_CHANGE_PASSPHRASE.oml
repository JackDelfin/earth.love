#INCLUDE[EL_TOKENS]#
#INCLUDE![EL_HEADER]#
<main class="w3-container w3-content" style="max-width:42rem">
  <section class="#BOX#">
    <h2>#MSG[Change passphrase]#</h2>
    <form name="change_passphrase" action="#_ORBIT#elpasswd" method="post" accept-charset="UTF-8" class="w3-container w3-left-align">
      <input type="hidden" name="csrf_token" value="#CSRF_TOKEN.html#">
      <input type="hidden" name="return_to" value="#RETURN_TO.html#">

      <div class="el-field">
        <label for="auth-current-passphrase">#MSG[Current passphrase]#</label>
        <input id="auth-current-passphrase" name="current_passphrase" type="password"
               class="w3-input w3-round-large"
               maxlength="128" autocomplete="current-password" required autofocus
               spellcheck="false" placeholder=" ">
      </div>

      <div class="el-field el-field-checked">
        <label for="auth-new-passphrase">#MSG[New passphrase]#</label>
        <p id="auth-new-passphrase-help" class="el-field-hint">#MSG[15 to 128 characters. Spaces are welcome.]#</p>
        <input id="auth-new-passphrase" name="new_passphrase" type="password"
               class="w3-input w3-round-large"
               minlength="15" maxlength="128" autocomplete="new-password" required
               spellcheck="false" placeholder=" "
               aria-describedby="auth-new-passphrase-help">
      </div>

      <div class="el-field">
        <label for="auth-confirm-passphrase">#MSG[Confirm new passphrase]#</label>
        <p id="auth-confirm-passphrase-help" class="el-field-hint">#MSG[Type the same passphrase again to catch typos.]#</p>
        <input id="auth-confirm-passphrase" name="confirm_passphrase" type="password"
               class="w3-input w3-round-large"
               minlength="15" maxlength="128" autocomplete="new-password" required
               spellcheck="false" placeholder=" "
               aria-describedby="auth-confirm-passphrase-help">
      </div>

      <button type="submit" class="w3-button w3-green w3-card-4 w3-round-large">
        #MSG[Change passphrase]#
      </button>
    </form>
  </section>
</main>
#INCLUDE![EL_FOOTER]#
